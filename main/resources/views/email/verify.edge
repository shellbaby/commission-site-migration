<!DOCTYPE html>
<html>
<head>
  <style>
    .button {
        --color-primary: #873e84;
        
        height: 24px;
        width: fit-content;
        border: 2px solid var(--color-primary);
        border-radius: 0.375rem;
        padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
        cursor: pointer;
        color: var(--color-black);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        text-decoration: none;
    }

    .button:not(:disabled):is(:hover, :focus-visible) {
        background: var(--color-primary);
        color: var(--color-white);
    }

    &:focus-visible {
        outline: none;
    }

    p, h2, small {
        line-height: calc(2px + 2ex + 2px);
    }

    h2 {
        font-size: 2.488rem;
        font-weight: 700;
    }

    small {
        font-size: 0.833rem;
        font-style: italic;
        font-weight: 700;
    }

    body {
        --spacing: 0.25rem;
        --color-black: #4a3052;
        --color-white: #fff1e8;
        
        background-color: var(--color-white);
        color: var(--color-black);
        margin: 0;
        font-family: monospace;
        font-weight: 400;
        padding: calc(var(--spacing) * 6);
    }

    body > *, main > * {
        margin: 0;
    }

    main {
        width: 75dvw;
        display: flex;
        flex-direction: column;
        gap: calc(var(--spacing) * 3);
    }

    main > p {
        overflow-wrap: break-word;
        word-wrap: break-word;
    }

  </style>
</head>
<body>
    <main>
        <h2>Just one last step!</h2>
        <p>Greetings, {{ client.name ?? client.username }}!</p>
        <p>Thank you for signing up and becoming one of our valuable customers at the Qilin Cafe. To finish creating your account, please click the button below to verify your email address.</p>
        
        <a href="{{ url }}" class="button">Verify Email Address</a>

        <p>If it doesn't work, please use this link instead:</p>
        <p>{{ url }}</p>
        
        <small>Note: This link will expire in 30 minutes.</small>
    </main>
</body>
</html>