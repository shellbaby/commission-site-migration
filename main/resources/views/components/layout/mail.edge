<!DOCTYPE html>
<html>

<head>
    <style>
        .button {
            --color-primary: #873e84;

            height: 24px;
            width: fit-content;
            border: 2px solid var(--color-primary);
            border-radius: 0.375rem;
            padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
            cursor: pointer;
            color: var(--color-black);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            text-decoration: none;
        }

        .button:not(:disabled):is(:hover, :focus-visible) {
            background: var(--color-primary);
            color: var(--color-white);
        }

        &:focus-visible {
            outline: none;
        }

        p,
        h2,
        h6,
        small {
            line-height: calc(2px + 2ex + 2px);
        }

        h2,
        h6 {
            font-weight: 700;
        }

        p {
            font-size: 1rem;
        }

        h2 {
            font-size: 2.488rem;
        }

        h6 {
            font-size: 1.2rem;
        }

        small {
            font-size: 0.833rem;
            font-style: italic;
            font-weight: 700;
        }

        body {
            --spacing: 0.25rem;
            --color-black: #4a3052;
            --color-white: #fff1e8;

            background-color: var(--color-white);
            color: var(--color-black);
            margin: 0;
            font-family: monospace;
            font-weight: 400;
            padding: calc(var(--spacing) * 6);
        }

        body>*,
        main>*,
        div>* {
            margin: 0;
        }

        main {
            width: 75dvw;
        }

        main>p {
            overflow-wrap: break-word;
            word-wrap: break-word;
        }
    </style>
</head>

<body>
    <main>
        {{{ await $slots.main() }}}
    </main>
</body>

</html>